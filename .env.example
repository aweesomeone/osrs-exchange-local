import { z } from 'zod';
import { env } from '../config/env.js';
import { AppError } from './errors.js';
import type { AggregatePrice, HistoryPoint, ItemMetadata, LatestPrice } from '../types.js';

const BASE_URL = env.OSRS_PRICE_API_BASE;
const USER_AGENT = env.OSRS_PRICE_API_USER_AGENT;

const itemSchema = z.object({
  id: z.union([z.string(), z.number()]).optional(),
  name: z.string().optional(),
  examine: z.string().optional(),
  members: z.union([z.boolean(), z.string()]).optional(),
  lowalch: z.union([z.number(), z.string()]).optional(),
  highalch: z.union([z.number(), z.string()]).optional(),
  limit: z.union([z.number(), z.string()]).optional(),
  value: z.union([z.number(), z.string()]).optional(),
  icon: z.string().optional(),
  itemId: z.union([z.string(), z.number()]).optional()
});

const latestEntrySchema = z.object({
  id: z.union([z.string(), z.number()]).optional(),
  itemId: z.union([z.string(), z.number()]).optional(),
  high: z.union([z.number(), z.string()]).nullable().optional(),
  low: z.union([z.number(), z.string()]).nullable().optional(),
  highTime: z.union([z.number(), z.string()]).nullable().optional(),
  lowTime: z.union([z.number(), z.string()]).nullable().optional()
});

const historyPointSchema = z.object({
  timestamp: z.union([z.number(), z.string()]).optional(),
  avgHighPrice: z.union([z.number(), z.string()]).nullable().optional(),
  avgLowPrice: z.union([z.number(), z.string()]).nullable().optional(),
  highPriceVolume: z.union([z.number(), z.string()]).nullable().optional(),
  lowPriceVolume: z.union([z.number(), z.string()]).nullable().optional()
});

class MemoryCache<T> {
  private cache = new Map<string, { value: T; expiresAt: number }>();

  get(key: string): T | undefined {
    const hit = this.cache.get(key);
    if (!hit) return undefined;
    if (hit.expiresAt <= Date.now()) {
      this.cache.delete(key);
      return undefined;
    }
    return hit.value;
  }

  set(key: string, value: T, ttlSeconds: number): void {
    this.cache.set(key, {
      value,
      expiresAt: Date.now() + ttlSeconds * 1000
    });
  }
}

const mappingCache = new MemoryCache<ItemMetadata[]>();
const latestCache = new MemoryCache<LatestPrice[]>();
const aggregateCache = new MemoryCache<AggregatePrice[]>();
const historyCache = new MemoryCache<HistoryPoint[]>();

const toNumber = (value: unknown): number | undefined => {
  if (typeof value === 'number' && Number.isFinite(value)) return value;
  if (typeof value === 'string' && value.trim() !== '') {
    const parsed = Number(value);
    if (Number.isFinite(parsed)) return parsed;
  }
  return undefined;
};

const normalizeItem = (raw: unknown): ItemMetadata | null => {
  const parsed = itemSchema.safeParse(raw);
  if (!parsed.success) return null;

  const itemId = toNumber(parsed.data.id ?? parsed.data.itemId);
  const name = parsed.data.name ?? 'Unknown item';
  if (!itemId) return null;

  return {
    id: itemId,
    name,
    examine: parsed.data.examine ?? undefined,
    members: typeof parsed.data.members === 'string' ? parsed.data.members === 'true' : parsed.data.members,
    lowalch: toNumber(parsed.data.lowalch),
    highalch: toNumber(parsed.data.highalch),
    limit: toNumber(parsed.data.limit),
    value: toNumber(parsed.data.value),
    icon: parsed.data.icon ?? undefined
  };
};

const normalizeLatestPrice = (raw: unknown): LatestPrice | null => {
  const parsed = latestEntrySchema.safeParse(raw);
  if (!parsed.success) return null;

  const itemId = toNumber(parsed.data.id ?? parsed.data.itemId);
  if (!itemId) return null;

  const high = toNumber(parsed.data.high);
  const low = toNumber(parsed.data.low);
  const highTime = toNumber(parsed.data.highTime);
  const lowTime = toNumber(parsed.data.lowTime);
  const newestTs = Math.max(highTime ?? 0, lowTime ?? 0);

  return {
    itemId,
    high,
    highTime,
    low,
    lowTime,
    fetchedAt: new Date().toISOString(),
    stale: newestTs === 0 || Date.now() / 1000 - newestTs > 600
  };
};

const normalizeHistoryPoint = (raw: unknown): HistoryPoint | null => {
  const parsed = historyPointSchema.safeParse(raw);
  if (!parsed.success) return null;

  const timestamp = toNumber(parsed.data.timestamp);
  if (!timestamp) return null;

  return {
    timestamp,
    avgHighPrice: toNumber(parsed.data.avgHighPrice),
    avgLowPrice: toNumber(parsed.data.avgLowPrice),
    highPriceVolume: toNumber(parsed.data.highPriceVolume),
    lowPriceVolume: toNumber(parsed.data.lowPriceVolume)
  };
};

async function fetchJson<T>(path: string): Promise<T> {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 10000);

  try {
    const response = await fetch(`${BASE_URL}${path}`, {
      headers: {
        'User-Agent': USER_AGENT,
        Accept: 'application/json'
      },
      signal: controller.signal
    });

    if (response.status === 429) {
      throw new AppError('OSRS Wiki rate limit reached. Please try again later.', 429);
    }

    if (!response.ok) {
      throw new AppError(`OSRS Wiki request failed with status ${response.status}.`, response.status || 500);
    }

    return (await response.json()) as T;
  } catch (error) {
    if (error instanceof Error && error.name === 'AbortError') {
      throw new AppError('The OSRS Wiki request timed out.', 504);
    }

    if (error instanceof AppError) {
      throw error;
    }

    throw new AppError('Failed to fetch OSRS Wiki data.', 502);
  } finally {
    clearTimeout(timeoutId);
  }
}

export async function fetchMappedItems(): Promise<ItemMetadata[]> {
  const cached = mappingCache.get('mapping');
  if (cached) return cached;

  const payload = await fetchJson<unknown>('/mapping');
  const entries = payload && typeof payload === 'object' ? Object.values(payload as Record<string, unknown>) : [];

  const items = entries
    .map(normalizeItem)
    .filter((item): item is ItemMetadata => Boolean(item))
    .sort((a, b) => a.name.localeCompare(b.name));

  mappingCache.set('mapping', items, env.MAPPING_CACHE_SECONDS);
  return items;
}

export async function fetchLatestPrices(): Promise<LatestPrice[]> {
  const cached = latestCache.get('latest');
  if (cached) return cached;

  const payload = await fetchJson<unknown>('/latest');
  const data = (payload as { data?: unknown } | unknown[] | undefined)?.data ?? payload;
  const entries = Array.isArray(data) ? data : Object.values((data ?? {}) as Record<string, unknown>);

  const prices = entries
    .map(normalizeLatestPrice)
    .filter((price): price is LatestPrice => Boolean(price));

  latestCache.set('latest', prices, env.LATEST_CACHE_SECONDS);
  return prices;
}

export async function fetchAggregatePrices(itemId: number, step: '5m' | '1h' | '6h' | '24h'): Promise<AggregatePrice[]> {
  const key = `aggregate:${itemId}:${step}`;
  const cached = aggregateCache.get(key);
  if (cached) return cached;

  const payload = await fetchJson<unknown>(`/${step}?id=${itemId}`);
  const data = (payload as { data?: unknown } | undefined)?.data ?? payload;
  const array = Array.isArray(data) ? data : Object.values((data ?? {}) as Record<string, unknown>);

  const normalized = array
    .map((entry) => {
      const parsed = historyPointSchema.safeParse(entry);
      if (!parsed.success) return null;
      const timestamp = toNumber(parsed.data.timestamp);
      if (!timestamp) return null;
      return {
        itemId,
        avgHighPrice: toNumber(parsed.data.avgHighPrice),
        avgLowPrice: toNumber(parsed.data.avgLowPrice),
        highPriceVolume: toNumber(parsed.data.highPriceVolume),
        lowPriceVolume: toNumber(parsed.data.lowPriceVolume),
        timestamp
      } satisfies AggregatePrice;
    })
    .filter((entry): entry is AggregatePrice => Boolean(entry));

  aggregateCache.set(key, normalized, env.AGGREGATE_CACHE_SECONDS);
  return normalized;
}

export async function fetchItemHistory(itemId: number, timestep: '5m' | '1h' | '6h' | '24h'): Promise<HistoryPoint[]> {
  const key = `history:${itemId}:${timestep}`;
  const cached = historyCache.get(key);
  if (cached) return cached;

  const payload = await fetchJson<unknown>(`/timeseries?id=${itemId}&timestep=${timestep}`);
  const data = (payload as { data?: unknown } | undefined)?.data ?? payload;
  const array = Array.isArray(data) ? data : Object.values((data ?? {}) as Record<string, unknown>);

  const history = array
    .map(normalizeHistoryPoint)
    .filter((entry): entry is HistoryPoint => Boolean(entry));

  historyCache.set(key, history, env.TIMESERIES_CACHE_SECONDS);
  return history;
}

export async function searchItems(query: string, limit = 50): Promise<ItemMetadata[]> {
  const items = await fetchMappedItems();
  const normalized = query.trim().toLowerCase();

  if (!normalized) {
    return items.slice(0, limit);
  }

  return items
    .filter((item) => {
      const haystack = `${item.name} ${String(item.id)}`.toLowerCase();
      return haystack.includes(normalized);
    })
    .slice(0, limit);
}
